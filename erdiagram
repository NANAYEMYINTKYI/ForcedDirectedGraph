}
// RELATIONSHIPS

// User relationships
Ref: users.role_id > roles.role_id
Ref: talents.user_id - users.user_id
Ref: companies.user_id - users.user_id

// Location relationships
Ref: companies.location_id > locations.location_id
Ref: talents.location_id > locations.location_id

// Company-talent relationships
Ref: companyMember.company_id - companies.company_id
Ref: companyMember.talent_id > talents.talent_id
Ref: invitation.sender_id > companies.company_id
Ref: invitation.receiver_id > talents.talent_id

// talent relationships
Ref: talent_expertise.talent_id > talents.talent_id
Ref: talent_expertise.expertise_id > expertise.expertise_id
Ref: talent_industries.talent_id > talents.talent_id
Ref: talent_industries.industry_id > industry.industry_id
Ref: talent_content.content_id > contents.contents_id
Ref: talent_content.talent_id > talents.talent_id

// Company relationships
Ref: company_expertise.company_id > companies.company_id
Ref: company_expertise.expertise_id > expertise.expertise_id
Ref: company_industries.company_id > companies.company_id
Ref: company_industries.industry_id > industry.industry_id
Ref: company_content.company_id > companies.company_id
Ref: company_content.content_id > contents.contents_id

// Content relationships
Ref: content_industries.content_id > contents.contents_id
Ref: content_industries.industry_id > industry.industry_id
Ref: content_expertise.content_id > contents.contents_id
Ref: content_expertise.expertise_id > expertise.expertise_id

// Management relationships
Ref: support_articles.written_by > management.management_id
Ref: ticket.assigned_to > management.management_id
Ref: contentManage.content_id > contents.contents_id
Ref: contentManage.manageBy > management.management_id
Ref: accountManage.user_id > users.user_id
Ref: accountManage.manageBy > management.management_id
